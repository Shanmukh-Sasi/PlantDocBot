[Unit]
Description=PlantDocBot FastAPI Backend
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/plantdocbot/backend
Environment=PATH=/opt/plantdocbot/venv/bin:/usr/bin
ExecStart=/opt/plantdocbot/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000 --workers 1
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
